{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["vite/client", "node"]
  },
  "include": ["src", "server", "scripts", "tests", "vite.config.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "scripts/.tmp-*.ts",
    "scripts/.tmp-reviewer-diagnostic.ts",
    "scripts/.tmp-reviewer-experiment.ts"
  ]
}
