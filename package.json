{
  "name": "zhixu-study",
  "version": "1.0.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc -b && vite build",
    "start": "tsx server/index.ts --production",
    "backup:db": "tsx scripts/backup-db.ts",
    "check:production": "tsx scripts/check-production-env.ts",
    "eval:teaching": "tsx scripts/eval-teaching.ts",
    "eval:teaching:broad": "tsx scripts/eval-teaching.ts --suite eval/teaching-suite-broad.json",
    "check": "tsc -b",
    "test": "tsx --test tests/*.test.ts",
    "test:production": "tsx --test tests/production-config.test.ts tests/server-http.test.ts"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "fflate": "^0.8.3",
    "katex": "^0.18.2",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.2.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  },
  "overrides": {
    "katex": "$katex"
  }
}
