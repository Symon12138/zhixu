# Full production env sample
# ============================================================================
# 这是生产部署模板，不是本地开发模板。
# 本地开发（npm run dev）不要整份复制：在项目根目录新建 .env，
# 只填写模型密钥行（GEMINI_API_KEY 或 OPENAI_API_KEY，按所选服务二选一），
# 其余保持默认/留空即可。
# 照抄本文件会强制登录（ZHIXU_AUTH_REQUIRED=true）、禁用个人 Key
# （ZHIXU_ALLOW_BYOK=false），并把公网域名指向 example.com。
# ============================================================================
# `npm run check:production` 会自动读取本文件（已存在的进程环境变量优先），
# 并复用与服务启动相同的校验规则：非法值直接以非零码退出。

## 部署（docker compose 读取；应用进程会忽略这些变量）
# 应用镜像必须带明确版本，禁止使用 latest。升级/回滚时改这一行，
# 再执行 docker compose up -d --no-build zhixu。
ZHIXU_IMAGE=zhixu-study:1.0.0
# 证书域名：必须与 ZHIXU_PUBLIC_ORIGIN 和 deploy/nginx.conf 的 server_name 一致。
# 首次签发使用 deploy/tls-bootstrap.sh（certbot standalone，先只启动应用）。
ZHIXU_TLS_DOMAIN=study.example.com
# Let's Encrypt 注册与到期通知邮箱。
ZHIXU_ACME_EMAIL=ops@example.com

## 公网访问
# 本地开发无需设置；生产域名必须与证书一致。
ZHIXU_PUBLIC_ORIGIN=https://study.example.com
ZHIXU_HOST=127.0.0.1
ZHIXU_PORT=3001
# 正式部署由同机/内网 nginx 终止 TLS，必须信任一层 X-Forwarded-For；
# 设为 false 会让所有用户共用代理 IP 的登录限流桶。仅本地直连测试可设 false。
ZHIXU_TRUST_PROXY=true

## 认证
# 本地开发不要照抄以下认证项：不设置 ZHIXU_AUTH_REQUIRED 即不强制登录，
# 不设置 ZHIXU_ALLOW_BYOK 即允许网页填写个人 Key。
# 生产模式禁止显式设为 false（进程会拒绝启动，预检同样失败）。
ZHIXU_AUTH_REQUIRED=true
# 开启后，个人模型/搜索 Key 加密保存在 ZHIXU_DATA_DIR/user_credentials 表；
# 加密密钥在 ZHIXU_DATA_DIR/credentials.key，备份数据库时必须同时备份该文件。
ZHIXU_ALLOW_BYOK=false
ZHIXU_COOKIE_SECURE=true

## 存储
ZHIXU_DATA_DIR=./.data

## 每用户每日额度
ZHIXU_QUOTA_CHAT=40
ZHIXU_QUOTA_DIAGNOSTIC=10
ZHIXU_QUOTA_REVIEW=30

# 单用户同时进行中的 AI 请求上限（单节点进程内保护，默认 2）
ZHIXU_MAX_CONCURRENT_AI=2

# 安全审计与每日用量保留天数（默认 90；生产模式禁止 0 或非法值）
ZHIXU_AUDIT_RETENTION_DAYS=90
ZHIXU_USAGE_RETENTION_DAYS=90

# 仅当 ZHIXU_ALLOW_BYOK=true 时生效：逗号分隔的 OpenAI 兼容端点 origin 白名单。
# 官方 OpenAI 端点 https://api.openai.com 始终允许；第三方兼容端点必须显式加入，
# 避免服务端被当作出站代理。为空且开启 BYOK 时，预检会打印明确配置提示。
ZHIXU_BYOK_BASEURLS=

# 仅限本机测试：允许 production 模式使用 http 与不安全 Cookie；公网必须保持 false/不设置。
ZHIXU_ALLOW_INSECURE_LOCAL=false

## 模型（密钥留空，仅服务端使用）
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
# OpenAI 兼容服务示例（把密钥只写在 .env，不要提交）：
# OPENAI_BASE_URL=https://your-openai-compatible-endpoint/v1
# OPENAI_MODEL=your-model-name
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# 原生 JSON 输出开关：只接受 true/false，默认开启。兼容服务不支持原生 JSON
# （请求报 4xx/400）时设为 false 显式关闭；关闭后仍走严格 JSON 解析与教学质量检查。
AI_STRUCTURED_OUTPUT=true

# 思考等级：auto / low / medium / high，非法值启动失败。网页临时配置优先于此项。
AI_THINKING_LEVEL=auto

## 指定网页来源核验（不是一个“事实正确”认证）
# 只接受 true/false。开启后，登录用户可在学习会话里添加公开 HTTPS 网页；服务端抓取正文，
# 可选逐字核验一段原文。只允许 HTTPS、默认端口、公开 DNS 地址，拒绝本机/内网。
ZHIXU_WEB_FETCH=false
# 可选：逗号分隔的裸域名；不要带协议、端口、路径或通配符。留空时允许任意公开 HTTPS 域名，
# 公网部署建议限制。
ZHIXU_WEB_ALLOWED_HOSTS=
# 单页原始字节上限、返回模型的正文字符上限、抓取超时、每用户每小时请求上限。
# 非法或越界值会阻止启动，不会静默回退默认值。
ZHIXU_WEB_MAX_BYTES=2097152
ZHIXU_WEB_MAX_TEXT=60000
ZHIXU_WEB_TIMEOUT_MS=15000
ZHIXU_WEB_HOURLY_LIMIT=30
# 自动联网搜索：内部实现参考 Magpie 的 search_api 设计，不调用 Magpie 运行时。
# 需要一个搜索供应商；you 可免费无 key（受第三方额度和网络影响）。
# 只接受 true/false；ZHIXU_SEARCH_ORDER 只允许支持的供应商名称。
ZHIXU_WEB_SEARCH=false
ZHIXU_SEARCH_ORDER=you,tavily,brave,exa,firecrawl,deepseek,searxng
# 按需填写；留空则不启用对应供应商。
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=
DEEPSEEK_API_KEY=
YOU_API_KEY=
SEARXNG_URL=
# 注意：搜索摘要会作为“来源片段”发送给模型，不等于页面全文或事实认证。
# 网页正文、URL 与抓取时间会随学习资料发送给所选模型。

# 单次模型请求上限，默认 60000 毫秒；只接受 10000–120000，整轮仍受 150 秒约束。
# 慢速推理模型可调到 90000；超时仍会拒绝发布并保持学习状态不变。
AI_MODEL_CALL_TIMEOUT_MS=60000

# 单次 OpenAI 兼容模型输出上限，默认 8192 token；只接受 512–8192。
# 跨主题开场可能需要较长思维链；该上限仍受单次 90 秒和整轮 150 秒约束。
# Gemini 不套用此上限，避免截断模型自身的思考预算。
AI_MAX_OUTPUT_TOKENS=8192

# 仅在排查延迟时开启；只接受 true/false，日志只记录目的、耗时、输出字符数，
# 不记录提示或回答。
AI_DEBUG_TIMING=false

# 可选：同一提供方端点上的独立评审模型。留空时仍由授课模型自评。
# 不同评审模型会启用最多两次针对性修订；评审调用不计为学习者理解证据。
# 网页临时密钥（BYOK）请求不会使用这里的评审模型，避免把用户密钥转交给额外模型。
AI_REVIEW_MODEL=
# 评审模型思考等级：auto / low / medium / high；留空按 auto，非法值启动失败。
AI_REVIEW_THINKING_LEVEL=auto
